rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid is string &&
             data.email is string &&
             (!('onboardingCompleted' in data) || data.onboardingCompleted is bool) &&
             (!('preferredLanguage' in data) || data.preferredLanguage is string);
    }

    function isValidFarm(data) {
      return data.keys().hasAll(['userId', 'name', 'cropType']) &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.cropType is string;
    }

    function isValidChat(data) {
      return data.userId == request.auth.uid;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['role', 'content', 'timestamp']) &&
             data.role in ['user', 'assistant'] &&
             data.content is string && data.content.size() < 5000;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      
      match /farms/{farmId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidFarm(request.resource.data);
        allow update: if isOwner(userId) && isValidFarm(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /chats/{chatId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidChat(request.resource.data);
        allow update: if isOwner(userId) && isValidChat(request.resource.data);
        
        match /messages/{messageId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId) && isValidMessage(request.resource.data);
        }
      }
    }
  }
}
